{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "QuickCopy",
    "version": "0.2.18"
  },
  "build": {
    "distDir": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickCopy",
        "url": "index.html?v=43",
        "width": 860,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "center": true,
        "visible": false
      },
      {
        "label": "about",
        "title": "关于与升级",
        "url": "about.html?v=4",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "viewer",
        "title": "图片预览",
        "url": "viewer.html?v=3",
        "width": 720,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      },
      "event": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "window": {
        "all": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}