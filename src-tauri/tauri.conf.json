{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPaste",
  "version": "0.2.2",
  "identifier": "com.qpaste.quickpaste",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickPaste",
        "url": "index.html?v=32",
        "width": 860,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false
      },
      {
        "label": "about",
        "title": "关于与升级",
        "url": "about.html?v=3",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "viewer",
        "title": "图片预览",
        "url": "viewer.html?v=2",
        "width": 720,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}