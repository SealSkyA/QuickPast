{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPaste",
  "version": "0.1.0",
  "identifier": "com.qpaste.quickpaste",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickPaste",
        "width": 860,
        "height": 600,
        "minWidth": 700,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      },
      {
        "label": "about",
        "title": "关于与升级",
        "url": "about.html",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"]
      }
    }
  }
}