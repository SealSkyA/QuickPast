{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "QuickCopy",
    "version": "0.2.18"
  },
  "build": {
    "distDir": "../ui",
    "devPath": "http://localhost:1420",
    "withGlobalTauri": true
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "QuickCopy",
        "url": "index.html",
        "width": 860,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "fileDropEnabled": true,
        "center": true,
        "visible": false
      },
      {
        "label": "about",
        "title": "关于与升级",
        "url": "about.html",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "viewer",
        "title": "图片预览",
        "url": "viewer.html",
        "width": 720,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.sealsky.quickcopy",
      "targets": ["nsis"],
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "languages": ["SimpChinese"],
          "installerIcon": "icons/icon.ico"
        }
      }
    }
  }
}